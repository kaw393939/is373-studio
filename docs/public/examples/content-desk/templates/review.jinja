{% extends 'base.jinja' %}{% block content %}<p class="eyebrow">Editor workspace</p><h1>Give each idea a final check.</h1><p>Read the full draft. Check its usefulness and source before you publish.</p>{% if articles %}<div class="grid">{% for item in articles %}<article class="card"><span class="tag">{{ item.category }} · draft</span><h2><a href="{{ url_for('article',article_id=item.id) }}">{{ item.title }}</a></h2><p>By {{ item.display_name }}</p><a href="{{ url_for('article',article_id=item.id) }}">Read and review →</a></article>{% endfor %}</div>{% else %}<div class="empty"><h2>All caught up.</h2><p>New member drafts and imported items will appear here.</p></div>{% endif %}{% endblock %}
