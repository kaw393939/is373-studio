{% extends 'base.jinja' %}{% block title %}{{ 'Create account' if register else 'Log in' }} · Content Desk{% endblock %}{% block content %}<section class="narrow"><p class="eyebrow">{{ 'Join the desk' if register else 'Welcome back' }}</p><h1>{{ 'Your first draft starts here.' if register else 'Pick up where you left off.' }}</h1><p>{{ 'New accounts are members. Admin access is assigned locally, never through this form.' if register else 'Use your own account or the credentials generated by the local seed command.' }}</p><form method="post" class="stack"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}">{% if register %}<label>Display name<input name="display_name" autocomplete="name" required minlength="2" maxlength="60" value="{{ request.form.get('display_name','') }}"></label>{% endif %}<label>Username<input name="username" autocomplete="username" required minlength="3" maxlength="30" pattern="[a-zA-Z0-9_-]+" value="{{ request.form.get('username','') }}"></label><label>Password<input type="password" name="password" autocomplete="{{ 'new-password' if register else 'current-password' }}" required {% if register %}minlength="12"{% endif %} maxlength="128"></label>{% if register %}<small>Use 12–128 characters. This is a local classroom app; choose a unique password.</small>{% endif %}<button>{{ 'Create member account' if register else 'Log in' }}</button></form><p>{% if register %}<a href="{{ url_for('login') }}">Already have an account? Log in.</a>{% else %}<a href="{{ url_for('register') }}">New here? Create a member account.</a>{% endif %}</p></section>{% endblock %}
