{% extends 'base.jinja' %}{% block content %}<p class="eyebrow">{{ g.user.role }} workspace</p><div class="title-row"><div><h1>Hello, {{ g.user.display_name }}.</h1><p>One useful idea is enough to get started.</p></div><a class="button" href="{{ url_for('new_draft') }}">Write a draft</a></div><h2>Your items</h2>{% if articles %}<div class="grid">{% for item in articles %}<article class="card"><span class="tag">{{ item.status }} · {{ item.category }}</span><h3><a href="{{ url_for('article',article_id=item.id) }}">{{ item.title }}</a></h3><p>{{ 'Waiting for an editor to review.' if item.status=='draft' else 'Visible on the public board.' }}</p></article>{% endfor %}</div>{% else %}<div class="empty"><h3>A blank page is a good place to start.</h3><p>Write a short event notice or learning tip. It stays private until an editor publishes it.</p></div>{% endif %}{% endblock %}
