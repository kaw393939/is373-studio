<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}Content Desk{% endblock %}</title><link rel="stylesheet" href="{{ url_for('static',filename='desk.css') }}"></head>
<body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href="{{ url_for('home') }}">Content<span>Desk</span><small>IS373 · local working reference</small></a><nav aria-label="Main">{% if g.user %}<a href="{{ url_for('dashboard') }}">My desk</a>{% if g.user.role=='admin' %}<a href="{{ url_for('review') }}">Review</a><a href="{{ url_for('pipeline') }}">Import</a>{% endif %}<a href="{{ url_for('account') }}">Account</a><form method="post" action="{{ url_for('logout') }}"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><button class="quiet">Log out</button></form>{% else %}<a href="{{ url_for('login') }}">Log in</a><a class="button small" href="{{ url_for('register') }}">Create account</a>{% endif %}</nav></header><main id="main">{% for message in get_flashed_messages() %}<p class="notice" role="status">{{ message }}</p>{% endfor %}{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}{% block content %}{% endblock %}</main><footer>Small workflow. Real server checks. Synthetic classroom content.<br><a href="https://kaw393939.github.io/is373-studio/examples/content-desk.html">Example guide &amp; limits</a></footer></body></html>
