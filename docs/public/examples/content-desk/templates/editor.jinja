{% extends 'base.jinja' %}{% block content %}<section class="narrow wide"><p class="eyebrow">Member → draft</p><h1>{{ 'Refine your draft.' if article else 'Share something useful.' }}</h1><p>Plain text only. Saving makes it available to an editor, not to visitors.</p><form method="post" class="stack"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><label>Title<input name="title" required minlength="3" maxlength="100" value="{{ request.form.get('title',article.title if article else '') }}"></label><label>Category<select name="category">{% for category in categories %}<option {% if request.form.get('category',article.category if article else '')==category %}selected{% endif %}>{{ category }}</option>{% endfor %}</select></label><label>Draft<textarea name="body" rows="8" required minlength="20" maxlength="4000">{{ request.form.get('body',article.body if article else '') }}</textarea></label><small>20–4,000 characters. Check that names, dates and claims are accurate before review.</small><button>Save draft</button></form></section>{% endblock %}
