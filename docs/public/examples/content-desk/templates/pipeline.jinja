{% extends 'base.jinja' %}{% block content %}<section class="narrow wide"><p class="eyebrow">Shared technical example · ETL</p><h1>Three sources.<br>Two useful drafts.</h1><p>Extract three synthetic documents, normalize spacing, merge duplicate content and load drafts for a person to review.</p><div class="steps vertical"><span><b>Extract</b> Three bundled JSON documents</span><span><b>Transform</b> Validate, normalize and deduplicate</span><span><b>Load</b> Drafts with source IDs attached</span></div><form method="post"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><button>Import classroom fixtures</button></form>{% if report %}<div class="notice" role="status"><h2>Import complete</h2><p><b>{{ report.added }}</b> drafts added · <b>{{ report.linked }}</b> additional sources linked · <b>{{ report.skipped }}</b> already imported · <b>{{ report.rejected|length }}</b> rejected</p>{% for rejected in report.rejected %}<p>{{ rejected }}</p>{% endfor %}<a href="{{ url_for('review') }}">Review the drafts →</a></div>{% endif %}<p class="muted">Try importing twice: the second run adds no duplicate drafts. This example reads only bundled synthetic fixtures. It does not fetch websites, call AI or publish automatically.</p></section>{% endblock %}
