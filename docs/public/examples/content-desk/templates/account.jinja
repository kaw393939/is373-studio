{% extends 'base.jinja' %}{% block content %}<section class="narrow"><p class="eyebrow">Account</p><h1>Make it yours.</h1><p>Username: <b>{{ g.user.username }}</b> · Role: <b>{{ g.user.role }}</b></p><form method="post" class="stack"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><label>Display name<input name="display_name" required minlength="2" maxlength="60" value="{{ request.form.get('display_name',g.user.display_name) }}"></label><button>Save display name</button></form><p class="muted">This bounded example supports a profile-name change. Password reset, email verification and account deletion are outside its scope.</p></section>{% endblock %}
