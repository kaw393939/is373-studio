{% extends 'base.jinja' %}{% block content %}<article class="reading"><p class="eyebrow">{{ article.category }} · {{ article.status }}</p><h1>{{ article.title }}</h1><p class="byline">By {{ article.display_name }}</p><div class="article-body">{{ article.body }}</div>{% if sources %}<aside class="provenance"><h2>Where this came from</h2><p>Normalized from permitted, synthetic classroom fixtures. No live source or AI generation is involved.</p><ul>{% for source in sources %}<li><b>{{ source.source_key }}</b> · {{ source.permission }}</li>{% endfor %}</ul>{% if article.status=='draft' %}<p>This draft preserves its imported source text. To make changes, <a href="{{ url_for('new_draft') }}">write a revised draft</a>.</p>{% endif %}</aside>{% endif %}{% if article.status=='draft' %}<div class="actions">{% if g.user and g.user.role=='admin' %}<form method="post" action="{{ url_for('publish',article_id=article.id) }}"><input type="hidden" name="csrf_token" value="{{ csrf_token() }}"><button>Publish this item</button></form>{% endif %}{% if g.user and g.user.id==article.owner_id and not article.fingerprint %}<a href="{{ url_for('edit_draft',article_id=article.id) }}">Edit your draft</a>{% endif %}</div>{% endif %}</article>{% endblock %}
