{% extends 'base.jinja' %}{% block content %}<section class="hero"><p class="eyebrow">A small publishing workflow</p><h1>Useful ideas.<br>Ready to share.</h1><p>Members draft. Editors review. Visitors read the published result.</p><div class="actions"><a class="button" href="{{ url_for('dashboard') if g.user else url_for('login') }}">{{ 'Open my desk' if g.user else 'Start with a draft' }}</a><a href="#published">Read published items ↓</a></div><div class="steps"><span><b>01</b> Write a draft</span><span><b>02</b> Review as an editor</span><span><b>03</b> Share with visitors</span></div></section><section id="published"><p class="eyebrow">Public board</p><h2>Reviewed and published</h2>{% if articles %}<div class="grid">{% for item in articles %}<article class="card"><span class="tag">{{ item.category }}</span><h3><a href="{{ url_for('article',article_id=item.id) }}">{{ item.title }}</a></h3><p>{{ item.body[:150] }}{% if item.body|length>150 %}…{% endif %}</p></article>{% endfor %}</div>{% else %}<div class="empty"><h3>Your first published item goes here.</h3><p>Save a draft as a member, then log in as your locally seeded admin to review and publish it.</p></div>{% endif %}</section>{% endblock %}
